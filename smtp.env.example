# Copy to smtp.env only when using the Gmail delivery mode. smtp.env is ignored by Git.
# Use a dedicated Gmail App Password, never your normal Google password.
SMTP_EMAIL=your-account@gmail.com
SMTP_APP_PASSWORD=
# Safest default: list only addresses allowed to receive local test messages.
SMTP_ALLOWED_RECIPIENTS=instructor-or-test-address@example.com
# Set true only in a controlled local environment when multiple recipients are required.
SMTP_ALLOW_ANY_RECIPIENT=false
