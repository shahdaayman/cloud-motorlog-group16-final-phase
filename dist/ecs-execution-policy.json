{
    "Version":  "2012-10-17",
    "Statement":  [
                      {
                          "Effect":  "Allow",
                          "Resource":  "arn:aws:logs:us-east-1:000000000000:log-group:/motorlog/ecs:*",
                          "Action":  [
                                         "logs:CreateLogStream",
                                         "logs:PutLogEvents"
                                     ]
                      },
                      {
                          "Effect":  "Allow",
                          "Resource":  "arn:aws:secretsmanager:us-east-1:000000000000:secret:motorlog-auth/rate-limit-key-R9PEYL",
                          "Action":  "secretsmanager:GetSecretValue"
                      }
                  ]
}