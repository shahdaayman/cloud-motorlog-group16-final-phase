# Copy this to .env and customize. Never commit .env.
NODE_ENV=development
PORT=3000
AWS_REGION=us-east-1
AWS_PROFILE=floci
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Backend and frontend origin. Local preview example:
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:4566
# Cognito values set after creating your user pool. Protected routes fail closed until configured.
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_ISSUER=
COGNITO_JWKS_URL=
REQUIRE_MFA=true
# Email and queue: configured later during deployment.
SES_FROM_EMAIL=no-reply@car-maintenance.local
NOTIFICATION_QUEUE_URL=
# Gmail delivery mode only. Leave these empty for local Floci SES capture.
# Prefer placing real values in ignored smtp.env as documented in README.md.
SMTP_EMAIL=
SMTP_APP_PASSWORD=
SMTP_ALLOWED_RECIPIENTS=
SMTP_ALLOW_ANY_RECIPIENT=false
# Daily manager mode: leave blank to auto-select Gmail when smtp.env is complete,
# otherwise local SES. Set explicitly to gmail or local to require that mode.
MOTORLOG_EMAIL_MODE=
# DynamoDB table prefix. Must match provision script.
TABLE_PREFIX=CML
# Lambda only: allowed source for internal cross-service calls
SERVICE_INTERNAL_SECRET=
# For local dev only, do not bypass authentication.
