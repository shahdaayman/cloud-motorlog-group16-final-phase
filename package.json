{
  "name": "car-maintenance-log-group16",
  "version": "1.0.0",
  "private": true,
  "description": "Group 16 Car Maintenance Log - three independently deployable AWS Lambda services on Floci",
  "type": "commonjs",
  "scripts": {
    "dev": "node backend/dev-server.js",
    "start": "node backend/dev-server.js",
    "test": "node --test tests/*.test.js",
    "check": "node --check backend/dev-server.js && node --test tests/*.test.js",
    "build": "node scripts/build.js",
    "audit:build": "node scripts/build-audit-logger.js",
    "db:prepare": "node scripts/create-tables.js",
    "db:migrate": "node scripts/create-tables.js",
    "smoke": "node scripts/smoke.js",
    "auth:setup": "node scripts/setup-auth.js",
    "smtp:test": "npm --prefix smtp-bridge test",
    "lambda:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-lambdas.ps1",
    "api:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-api.ps1",
    "cloud:deploy": "npm run lambda:deploy && npm run api:deploy",
    "cloud:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cloud-smoke.ps1",
    "reminders:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-reminder-automation.ps1",
    "reminders:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/reminder-schedule.ps1 status",
    "reminders:enable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/reminder-schedule.ps1 enable",
    "reminders:disable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/reminder-schedule.ps1 disable",
    "reminders:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-reminder-automation.ps1",
    "reminders:test-email": "node scripts/test-targeted-reminder-email.js",
    "iam:audit": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/audit-iam.ps1",
    "iam:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-iam-security.ps1",
    "iam:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-iam.ps1",
    "monitoring:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-monitoring.ps1",
    "monitoring:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/monitoring-status.ps1",
    "monitoring:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-monitoring.ps1",
    "s3:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-s3-frontend.ps1",
    "s3:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/s3-status.ps1",
    "s3:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-s3-frontend.ps1",
    "cloudfront:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-cloudfront.ps1",
    "cloudfront:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cloudfront-status.ps1",
    "cloudfront:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-cloudfront.ps1",
    "cloudfront:invalidate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/invalidate-cloudfront.ps1",
    "alb:targets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-alb-targets.ps1",
    "alb:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restart-alb-targets.ps1",
    "alb:cors": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/update-alb-cors.ps1",
    "alb:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-alb.ps1",
    "alb:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/alb-status.ps1",
    "alb:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-alb.ps1",
    "alb:rollback": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rollback-alb.ps1 -ConfirmRollback",
    "cloud-services:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-scale-security.ps1",
    "cloud-services:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-cloud-services.ps1",
    "load-tests:run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-load-tests.ps1"
  },
  "dependencies": {
    "@aws-sdk/client-api-gateway": "^3.1172.0",
    "@aws-sdk/client-cloudfront": "^3.1172.0",
    "@aws-sdk/client-cloudwatch": "^3.1171.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1176.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.900.0",
    "@aws-sdk/client-dynamodb": "^3.900.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1172.0",
    "@aws-sdk/client-eventbridge": "^3.1175.0",
    "@aws-sdk/client-iam": "^3.1172.0",
    "@aws-sdk/client-lambda": "^3.1172.0",
    "@aws-sdk/client-s3": "^3.1172.0",
    "@aws-sdk/client-scheduler": "^3.1172.0",
    "@aws-sdk/client-secrets-manager": "^3.1175.0",
    "@aws-sdk/client-sesv2": "^3.900.0",
    "@aws-sdk/client-sns": "^3.1175.0",
    "@aws-sdk/client-sqs": "^3.900.0",
    "@aws-sdk/lib-dynamodb": "^3.900.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "esbuild": "^0.25.0",
    "jsdom": "^31.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}
